# /etc/notch/notch.env — notch_api's settings on the VPS (root:notch, mode 0640).
#
# setup.sh copies this file there once and never overwrites it. Every <...> below is a
# placeholder: put the real values in on the VPS only, never in git. Each setting is
# described in notch_api/services.py and DEPLOY.md.

NOTCH_ENV=prod
NOTCH_HOST=127.0.0.1
NOTCH_PORT=4131

# The one database: metering, accounts, remote config, Notch Cloud ciphertext.
NOTCH_METER_DB=/var/lib/notch/meter.db
# ffmpeg's per-request directories: the tmpfs setup.sh mounts.
NOTCH_TMP=/var/lib/notch/tmp

# Supabase Auth: tokens are verified with the project's JWKS; the secret key deletes users.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<the project's secret API key, from its API Keys settings>

# Every model call. Use a key made for this server, with a credit limit.
OPENROUTER_API_KEY=<the OpenRouter key for this server>

# Request bodies are compared by HMAC under this key. Make one with: openssl rand -hex 32
# Changing it later makes every pending retry look like a reused key.
NOTCH_BODY_HMAC_KEY=<64 hex characters>

# Sign in with Apple token revocation on account deletion.
APPLE_TEAM_ID=<Apple developer team id>
APPLE_KEY_ID=<the Sign in with Apple key's id>
APPLE_CLIENT_ID=<the app's bundle id>
APPLE_PRIVATE_KEY_PATH=/etc/notch/apple-signin.p8
