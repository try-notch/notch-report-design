# /etc/systemd/system/notch-api.service — notch_api (/v2) on the VPS. See DEPLOY.md.
[Unit]
Description=Notch API (notch_api /v2, 127.0.0.1:4131)
After=network-online.target
Wants=network-online.target
# NOTCH_TMP: ffmpeg's per-request directories live in RAM, never on disk.
RequiresMountsFor=/var/lib/notch/tmp

[Service]
Type=simple
User=notch
Group=notch
WorkingDirectory=/opt/notch/app
EnvironmentFile=/etc/notch/notch.env
ExecStart=/opt/notch/venv/bin/python -m notch_api
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
# Scrubbed JSON lines on stderr go to journald; nothing is written anywhere else.
StandardOutput=journal
StandardError=journal

# The meter database and the tmpfs are the only places it may write.
ReadWritePaths=/var/lib/notch
UMask=0077

# Hardening. ffmpeg runs as a child and inherits all of it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=75%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
