# /etc/notch/dash.env — notch_dash on the VPS (root:notch, mode 0640), read after notch.env.
#
# The dashboard's Mac-only sources are switched off (an empty value turns a source off),
# and it admits requests that `tailscale serve` forwards from the tailnet. See DEPLOY.md.

NOTCH_DASH_PORT=4130
# This machine's name on the tailnet, as `tailscale status` shows it with the tailnet's domain.
NOTCH_DASH_HOSTS=<machine>.<tailnet>.ts.net
NOTCH_DASH_TAILNET=1

# No /v1 database, audio, Caddy access log, tunnel or phone on the VPS.
NOTCH_DB=
NOTCH_AUDIO_DIR=
NOTCH_METRICS=
NOTCH_DASH_CADDY_LOG=
NOTCH_DASH_SERVER_LOG=
NOTCH_DASH_TUNNEL_LOG=
NOTCH_DASH_TUNNEL_METRICS=
NOTCH_DASH_GATE_SECRET_FILE=
NOTCH_DASH_DEVICE=
