# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Both entry points load .env automatically via python-dotenv:
#   generate_report.py  (the report-writing call)
#   tagger.py           (the capture-time tagging call)
#
# Exporting the variable in your shell works just as well, and an exported
# value wins over this file:
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Never commit the real .env — it's in .gitignore.
ANTHROPIC_API_KEY=sk-ant-your-key-here
