# Copy this file to .env and fill in the keys you need:
#   cp .env.example .env
#
# .env is loaded automatically via python-dotenv, by the report demo (llm.py) and
# by the server (notch_api/config.py). Exporting a variable in your shell works
# just as well, and an exported value wins over this file:
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Neither key is needed for the offline checks: pytest, e2e/run_e2e.py --offline,
# or the server with NOTCH_FAKE_MODELS=1. CONTRIBUTING.md › "With a key" says
# which script reads which.
#
# Never commit the real .env — it's in .gitignore.

# The report demo: generate_report.py, tagger.py and eval_tags.py.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The server, e2e/, notch_api.seed, notch_api.eval_categories, eval_writing.py and
# eval_moods.py: every model call there goes through OpenRouter. Use a key of your
# own with a credit limit. Left empty, it counts as not set.
OPENROUTER_API_KEY=
